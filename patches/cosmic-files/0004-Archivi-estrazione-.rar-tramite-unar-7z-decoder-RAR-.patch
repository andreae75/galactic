+#[cfg(test)]
+mod galactic_mime_tests {
+    use super::*;
+
+    #[test]
+    fn sevenz_mime_detected() {
+        let Some(d) = std::env::var_os("GALACTIC_TEST_DIR").map(PathBuf::from) else { return };
+        let mime = mime_for_path(&d.join("prova.7z"), None, false);
+        eprintln!("MIME rilevato: {}", mime.essence_str());
+        assert!(SUPPORTED_ARCHIVE_TYPES.contains(&mime.essence_str()));
+    }
+}
+
+#[cfg(test)]
+mod galactic_rar_tests {
+    use super::*;
+
+    #[test]
+    fn rar_extract_real_archive() {
+        let (Some(rar), Some(out)) = (
+            std::env::var_os("GALACTIC_RAR_FILE").map(PathBuf::from),
+            std::env::var_os("GALACTIC_RAR_OUT").map(PathBuf::from),
+        ) else {
+            return;
+        };
+        let controller = Controller::default();
+        rar_extract(&rar, &out, None, &controller).unwrap();
+        let n = walk(&out);
+        eprintln!("file estratti: {n}");
+        assert!(n > 0);
+    }
+
+    fn walk(d: &Path) -> usize {
+        fs::read_dir(d)
+            .map(|rd| {
+                rd.filter_map(Result::ok)
+                    .map(|e| if e.path().is_dir() { walk(&e.path()) } else { 1 })
+                    .sum()
+            })
+            .unwrap_or(0)
+    }
+}
