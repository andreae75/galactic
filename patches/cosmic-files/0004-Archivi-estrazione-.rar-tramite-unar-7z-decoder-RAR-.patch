+/// Galactic: estrazione di archivi .rar tramite un programma esterno (`unar`, altrimenti `7z`/`7zz`).
+/// Il decodificatore RAR è codice proprietario di RARLAB e non si può incorporare in un programma GPL:
+/// per questo si usa uno strumento di sistema, se presente.
+fn rar_extract(
+    path: &Path,
+    directory: &Path,
+    password: Option<&str>,
+    controller: &Controller,
+) -> Result<(Vec<PathBuf>, HashSet<PathBuf>), OperationError> {
+    use std::process::{Command, Stdio};
+
+    fn in_path(name: &str) -> bool {
+        std::env::var_os("PATH")
+            .map(|p| std::env::split_paths(&p).any(|d| d.join(name).is_file()))
+            .unwrap_or(false)
+    }
+
+    fs::create_dir_all(directory).map_err(|e| OperationError::from_err(e, controller))?;
+
+    let mut cmd = if in_path("unar") {
+        let mut c = Command::new("unar");
+        c.arg("-q").arg("-D").arg("-r").arg("-o").arg(directory);
+        if let Some(pwd) = password {
+            c.arg("-p").arg(pwd);
+        }
+        c.arg(path);
+        c
+    } else if let Some(tool) = ["7zz", "7z", "7za"].into_iter().find(|t| in_path(t)) {
+        let mut c = Command::new(tool);
+        let mut out = std::ffi::OsString::from("-o");
+        out.push(directory);
+        c.arg("x").arg("-y").arg("-aou").arg(out);
+        // senza -p, 7z chiederebbe la password sul terminale: -p vuoto la fa fallire subito
+        c.arg(format!("-p{}", password.unwrap_or("")));
+        c.arg(path);
+        c
+    } else {
+        return Err(OperationError::from_err(
+            "per estrarre i .rar serve il programma 'unar' (sudo apt install unar) oppure '7z'",
+            controller,
+        ));
+    };
+    cmd.stdin(Stdio::null()).stdout(Stdio::null()).stderr(Stdio::piped());
+
+    let mut child = cmd.spawn().map_err(|e| OperationError::from_err(e, controller))?;
+    let mut stderr = child.stderr.take();
+    let stderr_thread = std::thread::spawn(move || {
+        let mut text = String::new();
+        if let Some(s) = stderr.as_mut() {
+            let _ = s.read_to_string(&mut text);
+        }
+        text
+    });
+
+    // attende la fine controllando ogni tanto annullamento/pausa dell'operazione
+    let status = loop {
+        match child.try_wait() {
+            Ok(Some(status)) => break status,
+            Ok(None) => {}
+            Err(e) => return Err(OperationError::from_err(e, controller)),
+        }
+        let checked = futures::executor::block_on(controller.check());
+        if let Err(state) = checked {
+            let _ = child.kill();
+            let _ = child.wait();
+            return Err(OperationError::from_state(state, controller));
+        }
+        std::thread::sleep(std::time::Duration::from_millis(200));
+    };
+    let text = stderr_thread.join().unwrap_or_default();
+
+    if status.success() {
+        return Ok(Default::default());
+    }
+    let lower = text.to_lowercase();
+    if lower.contains("password") || lower.contains("encrypted") || lower.contains("wrong") {
+        return Err(OperationError::from_kind(OperationErrorType::PasswordRequired, controller));
+    }
+    Err(OperationError::from_err(
+        if text.trim().is_empty() { format!("estrazione non riuscita ({status})") } else { text },
+        controller,
+    ))
+}
