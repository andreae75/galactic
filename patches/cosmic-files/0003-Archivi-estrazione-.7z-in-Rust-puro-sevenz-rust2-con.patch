+/// Galactic: estrazione di archivi .7z (sevenz-rust2, Rust puro), con annullamento, avanzamento e password.
+fn sevenz_extract(
+    path: &Path,
+    directory: &Path,
+    password: Option<&str>,
+    controller: &Controller,
+) -> Result<(Vec<PathBuf>, HashSet<PathBuf>), OperationError> {
+    use sevenz_rust2::{ArchiveReader, Error as SzError, Password};
+    use std::path::Component;
+
+    let to_err = |e: SzError| match e {
+        SzError::PasswordRequired | SzError::MaybeBadPassword(_) => {
+            OperationError::from_kind(OperationErrorType::PasswordRequired, controller)
+        }
+        e => OperationError::from_err(e, controller),
+    };
+
+    let pwd = password.map(Password::from).unwrap_or_else(Password::empty);
+    let file = fs::File::open(path).map_err(|e| OperationError::from_err(e, controller))?;
+    let mut reader = ArchiveReader::new(io::BufReader::new(file), pwd).map_err(to_err)?;
+    let total_files = reader.archive().files.len().max(1);
+
+    let mut written_files = Vec::with_capacity(total_files);
+    let mut target_dirs: HashSet<PathBuf> = HashSet::new();
+    let mut buffer = vec![0u8; 4 * 1024 * 1024];
+    let mut index = 0usize;
+
+    reader
+        .for_each_entries(|entry, data| {
+            let check = || -> io::Result<()> {
+                futures::executor::block_on(async {
+                    controller
+                        .check()
+                        .await
+                        .map_err(|s| io::Error::other(OperationError::from_state(s, controller)))
+                })
+            };
+            check()?;
+            controller.set_progress(index as f32 / total_files as f32);
+            index += 1;
+
+            // percorso sicuro: solo componenti normali (niente "..", niente percorsi assoluti)
+            let mut outpath = directory.to_path_buf();
+            for comp in Path::new(entry.name()).components() {
+                match comp {
+                    Component::Normal(c) => outpath.push(c),
+                    Component::CurDir => {}
+                    _ => {
+                        return Err(SzError::from(io::Error::new(
+                            io::ErrorKind::InvalidData,
+                            "percorso non valido nell'archivio",
+                        )));
+                    }
+                }
+            }
+            if outpath == directory {
+                return Ok(true);
+            }
+
+            if entry.is_directory() {
+                fs::create_dir_all(&outpath)?;
+                target_dirs.insert(outpath);
+                return Ok(true);
+            }
+            if entry.is_anti_item() {
+                return Ok(true);
+            }
+            if let Some(parent) = outpath.parent() {
+                fs::create_dir_all(parent)?;
+                target_dirs.insert(parent.to_path_buf());
+            }
+
+            let mut out = fs::File::create(&outpath)?;
+            let total = entry.size();
+            let mut current = 0u64;
+            loop {
+                check()?;
+                let count = data.read(&mut buffer)?;
+                if count == 0 {
+                    break;
+                }
+                out.write_all(&buffer[..count])?;
+                current += count as u64;
+                if total > 0 && current < total {
+                    controller.set_progress(
+                        (index as f32 - 1.0 + current as f32 / total as f32) / total_files as f32,
+                    );
+                }
+            }
+            drop(out);
+            if entry.has_last_modified_date {
+                let modified: SystemTime = entry.last_modified_date().into();
+                let _ = filetime::set_file_mtime(&outpath, filetime::FileTime::from_system_time(modified));
+            }
+            written_files.push(outpath);
+            Ok(true)
+        })
+        .map_err(to_err)?;
+
+    Ok((written_files, target_dirs))
+}
