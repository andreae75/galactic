+#[cfg(test)]
+mod galactic_tests {
+    use super::*;
+
+    // Archivi creati con `7z` in GALACTIC_TEST_DIR (prova.7z, prova-pw.7z, solid.7z; cartella "src" dentro)
+    fn dir() -> Option<PathBuf> {
+        std::env::var_os("GALACTIC_TEST_DIR").map(PathBuf::from)
+    }
+
+    fn same(a: &Path, b: &Path) -> bool {
+        fs::read(a).unwrap() == fs::read(b).unwrap()
+    }
+
+    #[test]
+    fn sevenz_plain_and_solid() {
+        let Some(d) = dir() else { return };
+        for name in ["prova.7z", "solid.7z"] {
+            let out = d.join(format!("out-{name}"));
+            let controller = Controller::default();
+            let (files, dirs) = sevenz_extract(&d.join(name), &out, None, &controller).unwrap();
+            assert_eq!(files.len(), 3, "{name}");
+            assert!(!dirs.is_empty());
+            for rel in ["src/a.txt", "src/sub/b.bin", "src/sub/gpl.txt"] {
+                assert!(same(&d.join(rel), &out.join(rel)), "{name}: {rel}");
+            }
+        }
+    }
+
+    #[test]
+    fn sevenz_password() {
+        let Some(d) = dir() else { return };
+        let controller = Controller::default();
+        let out = d.join("out-pw-no");
+        let err = sevenz_extract(&d.join("prova-pw.7z"), &out, None, &controller).unwrap_err();
+        assert!(matches!(err.kind, OperationErrorType::PasswordRequired), "senza password: {err:?}");
+        let controller = Controller::default();
+        let out = d.join("out-pw-ok");
+        let (files, _) =
+            sevenz_extract(&d.join("prova-pw.7z"), &out, Some("Segreta"), &controller).unwrap();
+        assert_eq!(files.len(), 3);
+        assert!(same(&d.join("src/sub/b.bin"), &out.join("src/sub/b.bin")));
+    }
+
+    #[test]
+    fn sevenz_wrong_password() {
+        let Some(d) = dir() else { return };
+        let controller = Controller::default();
+        let out = d.join("out-pw-bad");
+        assert!(sevenz_extract(&d.join("prova-pw.7z"), &out, Some("sbagliata"), &controller).is_err());
+    }
+}
