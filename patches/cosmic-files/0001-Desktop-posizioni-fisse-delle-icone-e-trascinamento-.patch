+    /// Desktop: se le icone trascinate sono già sul desktop, le sposta nella cella sotto il puntatore
+    /// e salva il layout. Restituisce true se ha gestito il rilascio.
+    fn try_move_desktop_icons(&mut self, to: &Location, paths: &[PathBuf]) -> bool {
+        let Location::Desktop(dir, ..) = to else {
+            return false;
+        };
+        if paths.is_empty() || !paths.iter().all(|p| p.parent() == Some(dir.as_path())) {
+            return false;
+        }
+        let (Some((cell_w, cell_h, cols, rows, pad)), Some((x, y))) =
+            (self.desktop_metrics.get(), self.desktop_dnd_pos)
+        else {
+            return true; // già sul desktop: niente da copiare
+        };
+        let Some(items) = self.items_opt.as_ref() else {
+            return true;
+        };
+        // posizioni attuali di tutte le icone visibili
+        let mut cells: HashMap<String, (usize, usize)> = HashMap::new();
+        let mut moving: Vec<(String, (usize, usize))> = Vec::new();
+        for item in items {
+            let Some((r, c)) = item.pos_opt.get() else {
+                continue;
+            };
+            cells.insert(item.name.clone(), (c, r));
+            if item.path_opt().is_some_and(|p| paths.contains(p)) {
+                moving.push((item.name.clone(), (c, r)));
+            }
+        }
+        if moving.is_empty() {
+            return true;
+        }
+        // cella sotto il puntatore
+        let tc = (((x as f32 - pad) / cell_w).floor().max(0.0) as usize).min(cols.saturating_sub(1));
+        let tr = (((y as f32 - pad) / cell_h).floor().max(0.0) as usize).min(rows.saturating_sub(1));
+        // l'icona "di riferimento" (la prima) va nella cella; le altre mantengono la distanza
+        let (_, (rc, rr)) = moving[0].clone();
+        let mut targets: Vec<(String, (usize, usize))> = Vec::new();
+        for (name, (c, r)) in &moving {
+            let nc = tc as isize + (*c as isize - rc as isize);
+            let nr = tr as isize + (*r as isize - rr as isize);
+            if nc < 0 || nr < 0 || nc as usize >= cols || nr as usize >= rows {
+                return true; // fuori dallo schermo: annulla
+            }
+            targets.push((name.clone(), (nc as usize, nr as usize)));
+        }
+        // la cella non deve essere occupata da un'icona che non si sta spostando
+        for (name, cell) in &targets {
+            if cells
+                .iter()
+                .any(|(n, c)| c == cell && n != name && !moving.iter().any(|(m, _)| m == n))
+            {
+                return true;
+            }
+        }
+        for (name, cell) in targets {
+            cells.insert(name, cell);
+        }
+        crate::desktop_layout::save(&cells);
+        true
+    }
