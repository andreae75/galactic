+// Posizioni fisse delle icone del desktop (colonna, riga) per nome di file.
+// File: ~/.config/cosmic/com.system76.CosmicFiles/desktop-layout.txt
+// Una riga per icona: "colonna riga nome" (es. "0 2 Jellyfin.desktop"). Le righe che
+// iniziano con # sono commenti. Le icone senza posizione vanno nella prima cella libera.
+
+use std::{
+    collections::HashMap,
+    path::PathBuf,
+    sync::Mutex,
+    time::SystemTime,
+};
+
+static CACHE: Mutex<Option<(Option<SystemTime>, HashMap<String, (usize, usize)>)>> =
+    Mutex::new(None);
+
+fn layout_path() -> Option<PathBuf> {
+    dirs::config_dir().map(|d| d.join("cosmic/com.system76.CosmicFiles/desktop-layout.txt"))
+}
+
+fn parse(text: &str) -> HashMap<String, (usize, usize)> {
+    let mut map = HashMap::new();
+    for line in text.lines() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let mut parts = line.splitn(3, char::is_whitespace);
+        let (Some(c), Some(r), Some(name)) = (parts.next(), parts.next(), parts.next()) else {
+            continue;
+        };
+        if let (Ok(c), Ok(r)) = (c.parse(), r.parse()) {
+            map.insert(name.trim().to_string(), (c, r));
+        }
+    }
+    map
+}
+
+/// Layout corrente; riletto solo quando il file cambia.
+pub fn load() -> HashMap<String, (usize, usize)> {
+    let Some(path) = layout_path() else {
+        return HashMap::new();
+    };
+    let mtime = std::fs::metadata(&path).and_then(|m| m.modified()).ok();
+    let mut cache = CACHE.lock().unwrap();
+    if let Some((cached_mtime, map)) = cache.as_ref() {
+        if *cached_mtime == mtime {
+            return map.clone();
+        }
+    }
+    let map = std::fs::read_to_string(&path)
+        .map(|t| parse(&t))
+        .unwrap_or_default();
+    *cache = Some((mtime, map.clone()));
+    map
+}
+
+/// Salva tutte le posizioni (ordinate, per leggibilità del file).
+pub fn save(cells: &HashMap<String, (usize, usize)>) {
+    let Some(path) = layout_path() else {
+        return;
+    };
+    let mut rows: Vec<_> = cells.iter().collect();
+    rows.sort_by_key(|(name, (c, r))| (*c, *r, (*name).clone()));
+    let mut text = String::from("# colonna riga nome  (scritto da COSMIC Files)\n");
+    for (name, (c, r)) in rows {
+        text.push_str(&format!("{c} {r} {name}\n"));
+    }
+    if let Some(dir) = path.parent() {
+        let _ = std::fs::create_dir_all(dir);
+    }
+    let tmp = path.with_extension("tmp");
+    if std::fs::write(&tmp, text).is_ok() {
+        let _ = std::fs::rename(&tmp, &path);
+    }
+}
