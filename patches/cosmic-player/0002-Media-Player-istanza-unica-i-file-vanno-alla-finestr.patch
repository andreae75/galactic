+// Galactic: istanza unica del lettore.
+// Il primo lettore apre un socket in $XDG_RUNTIME_DIR/cosmic-player.sock. Se si lancia di nuovo il
+// lettore (da un file, dal menu, ecc.) il nuovo processo non apre una seconda finestra: manda i file
+// al lettore già aperto e termina. `--new-window` forza una finestra separata. Il passaggio
+// Mini/normale (GALACTIC_HANDOFF) prende il posto dell'istanza precedente.
+
+use cosmic::iced::futures::{self, StreamExt};
+use cosmic::iced::{Subscription, stream};
+use std::any::TypeId;
+use std::io::{BufRead, BufReader, Write};
+use std::os::unix::net::{UnixListener, UnixStream};
+use std::path::PathBuf;
+use std::sync::{Mutex, OnceLock};
+
+use crate::Message;
+
+type Receiver = futures::channel::mpsc::UnboundedReceiver<Vec<url::Url>>;
+static RECEIVER: OnceLock<Mutex<Option<Receiver>>> = OnceLock::new();
+
+fn socket_path() -> Option<PathBuf> {
+    std::env::var_os("XDG_RUNTIME_DIR").map(|d| PathBuf::from(d).join("cosmic-player.sock"))
+}
+
+pub fn wants_new_window() -> bool {
+    std::env::args().any(|a| a == "--new-window")
+}
+
+pub fn is_handoff() -> bool {
+    std::env::var_os("GALACTIC_HANDOFF").is_some()
+}
+
+/// Se un lettore è già in esecuzione gli passa i file e restituisce `true`: questo processo deve uscire.
+pub fn forward_to_running(urls: &[String]) -> bool {
+    let Some(path) = socket_path() else {
+        return false;
+    };
+    let Ok(mut stream) = UnixStream::connect(path) else {
+        return false;
+    };
+    for url in urls {
+        if writeln!(stream, "OPEN {url}").is_err() {
+            return false;
+        }
+    }
+    if urls.is_empty() {
+        let _ = writeln!(stream, "RAISE");
+    }
+    true
+}
+
+/// Diventa il lettore "principale": apre il socket e ascolta le richieste degli altri.
+/// Da chiamare dopo il fork in background. In caso di passaggio Mini/normale prende il posto del precedente.
+pub fn become_primary() {
+    let Some(path) = socket_path() else {
+        return;
+    };
+    if !is_handoff() && UnixStream::connect(&path).is_ok() {
+        return; // c'è già un principale (finestra aperta con --new-window)
+    }
+    let _ = std::fs::remove_file(&path);
+    let Ok(listener) = UnixListener::bind(&path) else {
+        return;
+    };
+    let (tx, rx) = futures::channel::mpsc::unbounded();
+    let _ = RECEIVER.set(Mutex::new(Some(rx)));
+    std::thread::spawn(move || {
+        for stream in listener.incoming().flatten() {
+            let mut urls = Vec::new();
+            for line in BufReader::new(stream).lines().map_while(Result::ok) {
+                if let Some(url) = line.strip_prefix("OPEN ").and_then(|u| url::Url::parse(u).ok()) {
+                    urls.push(url);
+                }
+            }
+            let _ = tx.unbounded_send(urls);
+        }
+    });
+}
+
+pub fn subscription() -> Subscription<Message> {
+    struct SingleInstance;
+    Subscription::run_with(TypeId::of::<SingleInstance>(), |_| {
+        stream::channel(
+            5,
+            |mut msg_tx: futures::channel::mpsc::Sender<Message>| async move {
+                use futures::SinkExt;
+                let rx = RECEIVER.get().and_then(|m| m.lock().ok()?.take());
+                let Some(mut rx) = rx else {
+                    futures::future::pending::<()>().await;
+                    return;
+                };
+                while let Some(urls) = rx.next().await {
+                    if msg_tx.send(Message::SingleInstance(urls)).await.is_err() {
+                        break;
+                    }
+                }
+            },
+        )
+    })
+}
