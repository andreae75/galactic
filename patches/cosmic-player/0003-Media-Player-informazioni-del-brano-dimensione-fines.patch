+/// Galactic: un controllo con la spiegazione che compare al passaggio del mouse.
+fn con_suggerimento<'a>(
+    controllo: impl Into<Element<'a, Message>>,
+    testo: String,
+) -> Element<'a, Message> {
+    widget::tooltip(controllo, widget::text(testo), widget::tooltip::Position::Top).into()
+}
+
+/// Galactic: file dove il lettore ricorda la dimensione delle finestre (normale e Mini).
+fn file_dimensioni() -> Option<std::path::PathBuf> {
+    let base = std::env::var_os("XDG_CONFIG_HOME")
+        .map(std::path::PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|h| std::path::PathBuf::from(h).join(".config")))?;
+    Some(base.join("galactic").join("cosmic-player-finestra"))
+}
+
+/// Legge la dimensione salvata per la finestra "normale" o "mini".
+fn leggi_dimensione(tipo: &str) -> Option<Size> {
+    let testo = std::fs::read_to_string(file_dimensioni()?).ok()?;
+    testo.lines().find_map(|riga| {
+        let mut parti = riga.split_whitespace();
+        if parti.next()? != tipo {
+            return None;
+        }
+        let w: f32 = parti.next()?.parse().ok()?;
+        let h: f32 = parti.next()?.parse().ok()?;
+        (w >= 200.0 && h >= 120.0).then(|| Size::new(w, h))
+    })
+}
+
+/// Salva la dimensione della finestra "normale" o "mini", tenendo l'altra com'era.
+fn salva_dimensione(tipo: &str, size: Size) {
+    let Some(path) = file_dimensioni() else { return };
+    let vecchio = std::fs::read_to_string(&path).unwrap_or_default();
+    let mut righe: Vec<String> = vecchio
+        .lines()
+        .filter(|r| r.split_whitespace().next() != Some(tipo))
+        .map(String::from)
+        .collect();
+    righe.push(format!("{tipo} {} {}", size.width.round(), size.height.round()));
+    if let Some(dir) = path.parent() {
+        let _ = std::fs::create_dir_all(dir);
+    }
+    let _ = std::fs::write(&path, righe.join("\n") + "\n");
+}
