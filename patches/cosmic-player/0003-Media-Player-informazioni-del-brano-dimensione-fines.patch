+/// Galactic: riga con le informazioni tecniche dell'audio (formato, frequenza, bit, bitrate).
+/// Restituisce una stringa vuota finche' GStreamer non ha ancora negoziato il formato.
+fn audio_info(
+    video: &Video,
+    tags: &[gst::TagList],
+    current: i32,
+    duration: f64,
+    url: Option<&url::Url>,
+) -> String {
+    let pipeline = video.pipeline();
+    let idx = current.max(0);
+    let Some(pad) = pipeline.emit_by_name::<Option<gst::Pad>>("get-audio-pad", &[&idx]) else {
+        return String::new();
+    };
+    let Some(caps) = pad.current_caps() else {
+        return String::new();
+    };
+    let Some(s) = caps.structure(0) else {
+        return String::new();
+    };
+    let Ok(rate) = s.get::<i32>("rate") else {
+        return String::new();
+    };
+    let channels = s.get::<i32>("channels").unwrap_or(2);
+    let decoded = s.get::<&str>("format").unwrap_or("");
+
+    // Formato: dal tag del codec, altrimenti dall'estensione del file
+    let tag = tags.get(idx as usize).or(tags.first());
+    let codec_tag = tag
+        .and_then(|t| t.get::<gst::tags::AudioCodec>())
+        .map(|v| v.get().to_string())
+        .unwrap_or_default();
+    let low = codec_tag.to_lowercase();
+    let ext = url
+        .and_then(|u| u.path().rsplit_once('.').map(|(_, e)| e.to_uppercase()))
+        .unwrap_or_default();
+    let codec = if low.contains("flac") {
+        "FLAC".to_string()
+    } else if low.contains("layer 3") || low.contains("mp3") {
+        "MP3".to_string()
+    } else if low.contains("aac") {
+        "AAC".to_string()
+    } else if low.contains("vorbis") {
+        "Vorbis".to_string()
+    } else if low.contains("opus") {
+        "Opus".to_string()
+    } else if low.contains("alac") || low.contains("apple lossless") {
+        "ALAC".to_string()
+    } else if low.contains("pcm") || low.contains("wav") {
+        "PCM".to_string()
+    } else if !codec_tag.is_empty() {
+        codec_tag.clone()
+    } else {
+        ext
+    };
+    let lossless = matches!(codec.as_str(), "FLAC" | "ALAC" | "PCM" | "WAV" | "AIFF" | "APE" | "WV");
+
+    let mut parts: Vec<String> = Vec::new();
+    if !codec.is_empty() {
+        parts.push(codec);
+    }
+
+    // Frequenza: 44100 -> "44,1 kHz", 48000 -> "48 kHz"
+    let khz = rate as f64 / 1000.0;
+    parts.push(if khz.fract() == 0.0 {
+        format!("{} kHz", khz as i64)
+    } else {
+        format!("{} kHz", format!("{khz:.1}").replace('.', ","))
+    });
+
+    // Bit per campione: ha senso solo per i formati senza perdita
+    if lossless {
+        let bits = if decoded.contains("32") {
+            Some(32)
+        } else if decoded.contains("24") {
+            Some(24)
+        } else if decoded.contains("16") {
+            Some(16)
+        } else if decoded.contains('8') {
+            Some(8)
+        } else {
+            None
+        };
+        if let Some(bits) = bits {
+            parts.push(format!("{bits} bit"));
+        }
+    }
+
+    match channels {
+        1 => parts.push("mono".to_string()),
+        2 => {}
+        n => parts.push(format!("{n} canali")),
+    }
+
+    // Bitrate: dal tag, altrimenti la media calcolata da dimensione del file e durata
+    let tag_bitrate = tag.and_then(|t| {
+        t.get::<gst::tags::Bitrate>()
+            .map(|v| v.get())
+            .or_else(|| t.get::<gst::tags::NominalBitrate>().map(|v| v.get()))
+    });
+    let bitrate = tag_bitrate.filter(|b| *b > 0).map(|b| b as f64).or_else(|| {
+        let path = url?.to_file_path().ok()?;
+        let size = std::fs::metadata(path).ok()?.len() as f64;
+        (duration > 0.0).then(|| size * 8.0 / duration)
+    });
+    if let Some(bps) = bitrate {
+        let kbps = (bps / 1000.0).round() as u64;
+        let testo = kbps.to_string();
+        // separatore delle migliaia all'italiana: 1411 -> "1.411"
+        let mut con_punti = String::new();
+        for (i, c) in testo.chars().enumerate() {
+            if i > 0 && (testo.len() - i) % 3 == 0 {
+                con_punti.push('.');
+            }
+            con_punti.push(c);
+        }
+        parts.push(format!("{con_punti} kbit/s"));
+    }
+
+    parts.join(" · ")
+}
