diff --git a/src/sticky.rs b/src/sticky.rs
new file mode 100644
index 0000000..0963801
--- /dev/null
+++ b/src/sticky.rs
@@ -0,0 +1,111 @@
+// Galactic: chiede al compositore (COSMIC) di rendere "sticky" una finestra, cioè visibile su tutte le
+// aree di lavoro e disegnata sopra le altre finestre ("sempre in primo piano").
+// La finestra si riconosce dal titolo, che il Mini Player rende unico.
+
+use cosmic::cctk::{
+    self,
+    cosmic_protocols::toplevel_management::v1::client::zcosmic_toplevel_manager_v1,
+    sctk::{
+        self,
+        registry::{ProvidesRegistryState, RegistryState},
+    },
+    toplevel_info::{ToplevelInfoHandler, ToplevelInfoState},
+    toplevel_management::{ToplevelManagerHandler, ToplevelManagerState},
+    wayland_client::{Connection, QueueHandle, WEnum, globals::registry_queue_init},
+    wayland_protocols::ext::foreign_toplevel_list::v1::client::ext_foreign_toplevel_handle_v1::ExtForeignToplevelHandleV1,
+};
+
+struct Data {
+    registry_state: RegistryState,
+    info: ToplevelInfoState,
+    manager: ToplevelManagerState,
+}
+
+impl ProvidesRegistryState for Data {
+    fn registry(&mut self) -> &mut RegistryState {
+        &mut self.registry_state
+    }
+    sctk::registry_handlers!();
+}
+
+impl ToplevelManagerHandler for Data {
+    fn toplevel_manager_state(&mut self) -> &mut ToplevelManagerState {
+        &mut self.manager
+    }
+    fn capabilities(
+        &mut self,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+        _: Vec<WEnum<zcosmic_toplevel_manager_v1::ZcosmicToplelevelManagementCapabilitiesV1>>,
+    ) {
+    }
+}
+
+impl ToplevelInfoHandler for Data {
+    fn toplevel_info_state(&mut self) -> &mut ToplevelInfoState {
+        &mut self.info
+    }
+    fn new_toplevel(&mut self, _: &Connection, _: &QueueHandle<Self>, _: &ExtForeignToplevelHandleV1) {}
+    fn update_toplevel(&mut self, _: &Connection, _: &QueueHandle<Self>, _: &ExtForeignToplevelHandleV1) {}
+    fn toplevel_closed(&mut self, _: &Connection, _: &QueueHandle<Self>, _: &ExtForeignToplevelHandleV1) {}
+}
+
+sctk::delegate_registry!(Data);
+cctk::delegate_toplevel_info!(Data);
+cctk::delegate_toplevel_manager!(Data);
+
+/// Cerca (per qualche secondo) la finestra con questo titolo e la rende sticky. `true` se riuscito.
+pub fn make_sticky(title: &str, sticky: bool) -> bool {
+    let Ok(conn) = Connection::connect_to_env() else {
+        return false;
+    };
+    let Ok((globals, mut queue)) = registry_queue_init::<Data>(&conn) else {
+        return false;
+    };
+    let qh = queue.handle();
+    let registry_state = RegistryState::new(&globals);
+    let (Some(info), Some(manager)) = (
+        ToplevelInfoState::try_new(&registry_state, &qh),
+        ToplevelManagerState::try_new(&registry_state, &qh),
+    ) else {
+        log::warn!("sticky: il compositore non offre la gestione delle finestre");
+        return false;
+    };
+    let mut data = Data {
+        registry_state,
+        info,
+        manager,
+    };
+
+    for _ in 0..25 {
+        if queue.roundtrip(&mut data).is_err() {
+            return false;
+        }
+        let handle = data
+            .info
+            .toplevels()
+            .find(|t| t.title == title)
+            .and_then(|t| t.cosmic_toplevel.clone());
+        if let Some(handle) = handle {
+            if sticky {
+                data.manager.manager.set_sticky(&handle);
+            } else {
+                data.manager.manager.unset_sticky(&handle);
+            }
+            for _ in 0..5 {
+                let _ = queue.roundtrip(&mut data);
+                std::thread::sleep(std::time::Duration::from_millis(100));
+            }
+            let now = data
+                .info
+                .toplevels()
+                .find(|t| t.title == title)
+                .map(|t| format!("{:?}", t.state));
+            log::warn!("sticky: stato finestra dopo la richiesta: {now:?}");
+            return true;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(200));
+    }
+    log::warn!("sticky: finestra \"{title}\" non trovata");
+    false
+}
