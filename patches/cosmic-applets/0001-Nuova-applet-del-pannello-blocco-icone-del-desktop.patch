+// SPDX-License-Identifier: GPL-3.0-only
+//
+// Pulsante nel pannello: blocca/sblocca le icone del desktop (COSMIC Files).
+// Lo stato è la chiave "desktop_locked" (bool) nella configurazione di COSMIC Files;
+// se manca, il desktop è considerato bloccato.
+
+use cosmic::{
+    Task, app,
+    cosmic_config::{Config, ConfigGet, ConfigSet},
+    iced,
+};
+
+const FILES_ID: &str = "com.system76.CosmicFiles";
+const KEY: &str = "desktop_locked";
+
+fn read_locked() -> bool {
+    Config::new(FILES_ID, 1)
+        .ok()
+        .and_then(|c| c.get::<bool>(KEY).ok())
+        .unwrap_or(true)
+}
+
+struct Button {
+    core: cosmic::app::Core,
+    locked: bool,
+}
+
+#[derive(Debug, Clone)]
+enum Msg {
+    Press,
+}
+
+impl cosmic::Application for Button {
+    type Message = Msg;
+    type Executor = cosmic::SingleThreadExecutor;
+    type Flags = ();
+    const APP_ID: &'static str = "com.system76.CosmicAppletDesktopLock";
+
+    fn init(core: cosmic::app::Core, _: ()) -> (Self, app::Task<Msg>) {
+        (
+            Self {
+                core,
+                locked: read_locked(),
+            },
+            Task::none(),
+        )
+    }
+
+    fn core(&self) -> &cosmic::app::Core {
+        &self.core
+    }
+
+    fn core_mut(&mut self) -> &mut cosmic::app::Core {
+        &mut self.core
+    }
+
+    fn style(&self) -> Option<iced::theme::Style> {
+        Some(cosmic::applet::style())
+    }
+
+    fn update(&mut self, message: Msg) -> app::Task<Msg> {
+        match message {
+            Msg::Press => {
+                let new = !read_locked();
+                match Config::new(FILES_ID, 1) {
+                    Ok(c) => {
+                        if let Err(err) = c.set(KEY, new) {
+                            tracing::error!("impossibile salvare {KEY}: {err}");
+                        }
+                    }
+                    Err(err) => tracing::error!("config COSMIC Files non raggiungibile: {err}"),
+                }
+                self.locked = read_locked();
+            }
+        }
+        Task::none()
+    }
+
+    fn view(&self) -> cosmic::Element<'_, Msg> {
+        let icon = if self.locked {
+            "changes-prevent-symbolic"
+        } else {
+            "changes-allow-symbolic"
+        };
+        self.core
+            .applet
+            .icon_button(icon)
+            .on_press_down(Msg::Press)
+            .into()
+    }
+}
+
+pub fn run() -> iced::Result {
+    cosmic::applet::run::<Button>(())
+}
